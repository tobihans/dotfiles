{
  "lastChangelogVersion": "1.4.0",
  "theme": "dark",
  "terminal": {
    "showTerminalProgress": true,
    "clearOnShrink": false,
    "imageWidthCells": 60
  },
  "enableInstallTelemetry": false,
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-terra",
  "defaultThinkingLevel": "high",
  "defaultTools": [
    "+codemode",
    "+tool_search"
  ],
  "packages": [
    "npm:pi-subagents@0.83.1",
    "npm:pi-ask-user@0.17.0",
    "npm:pi-web-access@0.45.0",
    "npm:@plannotator/pi-extension@0.28.35",
    "npm:@gotgenes/pi-permission-system@42.0.0",
    "git:github.com/DietrichGebert/ponytail@16352ac229eb08a9598dcae48fe9f2b342567d86"
  ],
  "quietStartup": false,
  "defaultProjectTrust": "ask",
  "editorPaddingX": 0,
  "hideThinkingBlock": true,
  "markdown": {
    "mermaid": "streaming"
  },
  "treeFilterMode": "default",
  "showHardwareCursor": false,
  "collapseChangelog": false,
  "showCacheMissNotices": true,
  "autocompleteMaxVisible": 7
}

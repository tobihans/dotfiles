# vim: ft=gitignore

# NOTE: Contains config files to be ignored on any non Linux system
# .config/{nushell,lazygit,lazydocker} are NOT here: Linux and Windows both read
# them from ~/.config (chezmoi writes %USERPROFILE%\.config on Windows), so they
# moved to ignore/on-darwin.

.audiorelay/
.bash_aliases
.bash_profile
.bashrc
.config/environment.d/
.config/kitty/
.config/systemd/
.disk-prune.sh
.functions
.inputrc
.local/share/applications
.local/share/icons
.local/share/plasma_notes
.nanorc
